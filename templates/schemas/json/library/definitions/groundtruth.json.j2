{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "kubernetesObjectRef": {
            "properties": {
                "apiVersion": {
                    "type": "string"
                },
                "kind": {
                    "type": "string"
                },
                "metadata": {
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "namespace": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "name",
                        "namespace"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "apiVersion",
                "kind",
                "metadata"
            ],
            "type": "object"
        }
    },
    "properties": {
        "alerts": {
            "items": {
                "properties": {
                    "labels": {
                        "type": "object"
                    },
                    "name": {
                        "enum": {{ ids["alerts"] | tojson }},
                        "type": "string"
                    }
                },
                "required": [
                    "labels",
                    "name"
                ],
                "type": "object"
            },
            "type": "array"
        },
        "entities": {
            "items": {
                "$ref": "#/$defs/kubernetesObjectRef"
            },
            "type": "array"
        },
        "solutions": {
            "items": {
                "items": {
                    "properties": {
                        "steps": {
                            "items": {
                                "properties": {
                                    "command": {
                                        "type": "string"
                                    },
                                    "text": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "text"
                                ],
                                "type": "object"
                            },
                            "minItems": 1,
                            "type": "array"
                        }
                    },
                    "required": [
                        "steps"
                    ],
                    "type": "object"
                },
                "type": "array"
            },
            "type": "array"
        }
    },
    "required": [
        "alerts",
        "entities",
        "solutions"
    ],
    "type": "object"
}
