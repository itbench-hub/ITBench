---
cluster:
  kubernetes:
    version: 1.35.3
  networking:
    mode: cilium
  nodes:
    control:
      count: 1
      instance_type: m5.xlarge
      # image: ""              # Optional: AMI ID or kOps image alias (e.g. ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*). Uses kOps channel default when omitted.
      # root_volume_size: 64   # Optional: Root EBS volume size in GiB. Defaults to 64.
    worker:
      count: 3
      instance_type: m5.2xlarge
      # image: ""              # Optional: AMI ID or kOps image alias. Uses kOps channel default when omitted.
      # root_volume_size: 128  # Optional: Root EBS volume size in GiB. Defaults to 128.
  # ssh_access_cidrs:          # Optional: CIDRs allowed SSH access to nodes. Defaults to the VPC CIDR. Avoid 0.0.0.0/0 in production.
  #   - "10.0.0.0/16"
  # api_access_cidrs:          # Optional: CIDRs allowed to reach the Kubernetes API server. Defaults to the VPC CIDR. Avoid 0.0.0.0/0 in production.
  #   - "10.0.0.0/16"
