---
apiVersion: itbench.io/v2
kind: EvaluationCriteria
metadata:
  name: {{ ["scenario", scenario.id] | ansible.builtin.join("-") }}
spec:
{% set _result_invert = {"fail": "pass", "pass": "fail", "false": "true", "true": "false"} %}
{% if scenario.states is ansible.builtin.defined and scenario.states | length > 0 %}
  checks:
{% for state in scenario.states %}
{% if state.backend == "kyverno-policy-report" %}
    - backend: kyverno-policy-report
      passingResult: {{ _result_invert[state.expectedResult] | default("pass") }}
{% if state.policyName is ansible.builtin.defined %}
      policyName: {{ state.policyName }}
{% endif %}
{% if state.resource is ansible.builtin.defined %}
      resource: {{ state.resource }}
{% endif %}
{% elif state.backend == "opa-eval" %}
    - backend: opa-eval
      passingResult: {{ _result_invert[state.expectedResult] | default("true") }}
      # expectedFiles: use fetcher.sh for kubectl-based fetchers, fetcher.yml for ansible-playbook fetchers
      expectedFiles:
        - policy.rego
        - fetcher.sh
{% if state.policyName is ansible.builtin.defined %}
      # For policy integrity checks, replace expectedFiles with policyName + expectedRules:
      # policyName: {{ state.policyName }}
      # expectedRules: []
{% endif %}
{% elif state.backend == "policy-unchanged" %}
    # policy-unchanged maps to opa-eval with expectedRules.
    # Fill in policyName and expectedRules before using.
    - backend: opa-eval
      passingResult: "true"
      policyName: {{ state.policyName | default("") }}
      expectedRules: []
{% endif %}
{% endfor %}
{% elif scenario.alerts is ansible.builtin.defined and scenario.alerts | length > 0 %}
  checks:
{% for alert in scenario.alerts %}
    - backend: prometheus-alert-absent
      alertName: {{ alert }}
{% endfor %}
{% else %}
  checks: []
{% endif %}
