---
apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  labels:
    "itbench.io/ansible-role": argo
    "itbench.io/layer": orchestration
  name: itbench-scenario-execution
  namespace: "[[ argo_namespace ]]"
spec:
  arguments:
    parameters:
      - name: scenario
      - name: workflow_variant
        value: full
      - name: environment_secret
        value: environment-1-kubeconfig
      - name: trial
        value: "1"
      - name: s3_directory
        value: ""
  entrypoint: scenario-execution
  # Runs that target the same environment cluster queue behind each other.
  synchronization:
    mutex:
      name: "{{workflow.parameters.environment_secret}}"
  volumes:
    - name: kubeconfig-volume
      secret:
        secretName: "{{workflow.parameters.environment_secret}}"
  templates:
    - name: scenario-execution
      dag:
        tasks:
          - name: deploy-environment
            template: run-itbench-step
            when: "{{workflow.parameters.workflow_variant}} != teardown"
            arguments:
              parameters:
                - name: args
                  value: deploy environment --scenario {{workflow.parameters.scenario}}

          - name: remove-events
            template: run-itbench-step
            depends: "deploy-environment.Succeeded || deploy-environment.Skipped"
            when: "{{workflow.parameters.workflow_variant}} != teardown"
            arguments:
              parameters:
                - name: args
                  value: remove events

          - name: pre-injection-pause
            template: pause-step
            depends: "remove-events.Succeeded || remove-events.Skipped"
            when: "{{workflow.parameters.workflow_variant}} != teardown"
            arguments:
              parameters:
                - name: duration
                  value: "2m"

          - name: inject-faults
            template: run-itbench-step
            depends: "pre-injection-pause.Succeeded || pre-injection-pause.Skipped"
            when: "{{workflow.parameters.workflow_variant}} != teardown"
            arguments:
              parameters:
                - name: args
                  value: inject faults --scenario {{workflow.parameters.scenario}}

          - name: teardown-pause
            template: pause-step
            depends: "inject-faults.Succeeded || inject-faults.Skipped"
            when: "{{workflow.parameters.workflow_variant}} == full"
            arguments:
              parameters:
                - name: duration
                  value: "10m"

          # Everything below runs whether or not the steps above succeeded.
          - name: export-records
            template: run-itbench-step
            depends: "teardown-pause.Succeeded || teardown-pause.Skipped || inject-faults.Failed || pre-injection-pause.Failed || remove-events.Failed || deploy-environment.Failed"
            when: "{{workflow.parameters.workflow_variant}} != setup"
            arguments:
              parameters:
                - name: args
                  value: export records

          - name: remove-faults
            template: run-itbench-step
            depends: "export-records.Succeeded || export-records.Failed || export-records.Skipped"
            when: "{{workflow.parameters.workflow_variant}} != setup"
            arguments:
              parameters:
                - name: args
                  value: remove faults

          - name: undeploy-environment
            template: run-itbench-step
            depends: "remove-faults.Succeeded || remove-faults.Failed || remove-faults.Skipped"
            when: "{{workflow.parameters.workflow_variant}} != setup"
            arguments:
              parameters:
                - name: args
                  value: undeploy environment --yes

    - name: run-itbench-step
      inputs:
        parameters:
          - name: args
      container:
        image: quay.io/it-bench/bench-runner:1.0.0
        imagePullPolicy: IfNotPresent
        command:
          - /bin/sh
          - -c
        args:
          - itbench {{inputs.parameters.args}}
        env:
          - name: KUBECONFIG
            value: /etc/itbench/kubeconfig
          - name: PYTHONUNBUFFERED
            value: "1"
          - name: ITBENCH_S3_BUCKET
            value: "[[ storage_s3_bucket | default('') ]]"
          - name: ITBENCH_S3_ENDPOINT
            value: "[[ storage_s3_endpoint | default('') ]]"
          - name: ITBENCH_S3_DIRECTORY
            value: "{{workflow.parameters.s3_directory}}"
        envFrom:
          # Provides ITBENCH_S3_USERNAME and ITBENCH_S3_PASSWORD.
          - secretRef:
              name: aws-credentials
              optional: true
        volumeMounts:
          - name: kubeconfig-volume
            mountPath: /etc/itbench
            readOnly: true

    - name: pause-step
      inputs:
        parameters:
          - name: duration
      suspend:
        duration: "{{inputs.parameters.duration}}"
