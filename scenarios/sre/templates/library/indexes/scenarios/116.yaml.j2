      kubernetesObject:
        apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: frontend
          namespace: {{ releases["applications"]["opentelemetry_demo"]["kubernetes"]["namespace"] }}
    id: exhausted-etcd-database-storage
environment:
  applications:
  - id: opentelemetry-demo
id: 116
solutionTemplates:
