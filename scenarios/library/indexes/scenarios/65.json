                                "name": "backend",
                                "namespace": "benchmarks"
                            }
                        }
                    },
                    "id": "active-host-network-kubernetes-deployment"
                }
            ]
        }
    ],
    "environment": {
        "applications": []
    },
    "id": 65,
    "index": 65,
    "platforms": [
        "Kubernetes"
    ],
    "solutions": [
        [
            {
                "steps": [
                    {
                        "command": "kubectl -n benchmarks delete deployment backend",
                        "text": "Delete the non-compliant Deployment that uses hostNetwork."
                    },
                    {
                        "text": "Author and apply a Kyverno ClusterPolicy that disallows hostNetwork on all workloads."
                    }
                ]
            }
        ]
    ],
