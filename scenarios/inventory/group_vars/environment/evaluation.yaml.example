---
# Optional — override evaluation timing defaults for this environment.
# Remove this file or leave evaluation_overrides empty to use role defaults:
#   window: 300, interval: 30, pass_mark: 2
evaluation_overrides:
  window: 300   # total seconds the watcher polls before declaring failure
  interval: 30  # seconds between poll cycles
  pass_mark: 2  # consecutive passing poll cycles required to declare success
