{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "archive/**"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "ansible",
        "dockerfile",
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": false
    },
    {
      "matchFileNames": [
        "components/recorders/**",
        "components/telemetry/**",
        "inventory/group_vars/all/container_image.yaml"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": true
    },
    {
      "groupName": "ITBench Components",
      "groupSlug": "itbench-components-group",
      "matchPackageNames": [
        "quay.io/it-bench/hello-bench-arm64",
        "quay.io/it-bench/hello-bench-amd64",
        "quay.io/it-bench/prometheus-recorder",
        "quay.io/it-bench/clickhouse-recorder",
        "quay.io/it-bench/topology-writer",
        "quay.io/it-bench/opentelemetry-collector",
        "quay.io/it-bench/bench-runner"
      ]
    },
    {
      "groupName": "OpenTelemetry Collector Builder Dependencies",
      "groupSlug": "opentelemetry-collector-builder-group",
      "matchManagers": [
        "ocb"
      ],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "enabled": false,
      "matchFileNames": [
        "project/roles/faults/tasks/inject_nonexistent_kubernetes_workload_container_image.yaml"
      ],
      "matchManagers": [
        "ansible"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.access.redhat.com/ubi10/go-toolset"
      ],
      "extractVersion": "^(?<version>1\\.\\d+\\.\\d+-\\d+)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)inventory\\/group_vars\\/all\\/helm_chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*reference:[^\\n]*\\n\\s*version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/)inventory\\/group_vars\\/all\\/github_release\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*url:[^\\n]*?(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/)inventory\\/group_vars\\/all\\/container_image\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*digest:\\s*\"(?<currentDigest>sha256:[a-f0-9]+)\"\\s*\\n\\s*reference:[^\\n]*\\n\\s*tag:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|\\/)mise\\.[^\\/]*toml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z][A-Z0-9_]*\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)molecule\\/[^\\/]+\\/create\\.ya?ml$/"
      ],
      "matchStrings": [
        "chart_ref:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?(?:\\s+.*)*\\s+chart_repo_url:\\s*[\"']?(?<registryUrl>https?:\\/\\/[^\"'\\s]+)[\"']?(?:\\s+.*)*\\s+chart_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)components\\/recorders\\/[^\\/]+\\/.*_test\\.go$/",
        "/(^|\\/)components\\/telemetry\\/topology\\/.*_test\\.go$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[a-zA-Z0-9._\\/-]+):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|\\/)templates\\/.*\\.ya?ml\\.j2$/"
      ],
      "matchStrings": [
        "image:\\s*[\"']?(?<depName>[a-zA-Z0-9._\\/-]+):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "ocb": {
    "managerFilePatterns": [
      "/(^|/)builder(-config)?.ya?ml$/"
    ]
  }
}
