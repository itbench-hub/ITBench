{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "All OpenTelemetry Collector Builder Dependencies",
      "groupSlug": "opentelemetry-collector-builder-group",
      "matchPackageNames": [
        "/^github.com/open-telemetry/opentelemetry-collector-contrib/connector//",
        "/^github.com/open-telemetry/opentelemetry-collector-contrib/exporter//",
        "/^github.com/open-telemetry/opentelemetry-collector-contrib/extension//",
        "/^github.com/open-telemetry/opentelemetry-collector-contrib/processor//",
        "/^github.com/open-telemetry/opentelemetry-collector-contrib/receiver//",
        "/^go.opentelemetry.io/collector/confmap/provider//",
        "/^go.opentelemetry.io/collector/connector//",
        "/^go.opentelemetry.io/collector/exporter//",
        "/^go.opentelemetry.io/collector/extension//",
        "/^go.opentelemetry.io/collector/processor//",
        "/^go.opentelemetry.io/collector/receiver//"
      ]
    },
    {
      "enabled": false,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.access.redhat.com/ubi10/go-toolset"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "enabled": false,
      "matchFileNames": [
        "scenarios/sre/project/roles/faults/tasks/inject_nonexistent_kubernetes_workload_container_image.yaml"
      ],
      "matchManagers": [
        "ansible"
      ]
    },
    {
      "lockFileMaintenance": {
        "enabled": true
      },
      "matchManagers": [
        "gomod",
        "pep621"
      ]
    }
  ],
  "ansible": {
    "managerFilePatterns": [
      "/(^|/)molecule/[^/]+/create\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Matches OCI Helm charts inside tasks/install_*.yaml and molecule create.yml files",
      "customType": "regex",
      "fileMatch": [
        "(^|\\/)tasks\\/install_[^\\/]*\\.yaml$",
        "(^|\\/)molecule\\/[^\\/]+\\/create\\.ya?ml$"
      ],
      "matchStrings": [
        "chart_ref:\\s*[\"']oci:\\/\\/(?<depName>[^\"'\\s]+)[\"'](?:\\s+.*)*\\s+chart_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "description": "Matches alphabetized Ansible HTTP Helm tasks (using helm datasource)",
      "customType": "regex",
      "fileMatch": [
        "(^|\\/)tasks\\/install_[^\\/]*\\.yaml$",
        "(^|\\/)molecule\\/[^\\/]+\\/create\\.ya?ml$"
      ],
      "matchStrings": [
        "chart_ref:\\s*[\"']?(?<depName>[^\"'\\s]+)[\"']?(?:\\s+.*)*\\s+chart_repo_url:\\s*[\"']?(?<registryUrl>https?:\\/\\/[^\"'\\s]+)[\"']?(?:\\s+.*)*\\s+chart_version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "description": "Matches alphabetized native Git clone tasks",
      "customType": "regex",
      "fileMatch": [
        "(^|\\/)tasks\\/install_[^\\/]*\\.yaml$"
      ],
      "matchStrings": [
        "repo:\\s*[\"']?https?:\\/\\/github\\.com\\/(?<depName>[^\\/]+\\/[^\\/\\s.]+)(?:\\.git)?[\"']?(?:\\s+.*)*\\s+version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Matches Kubernetes Gateway API release tag in the kubectl apply URL",
      "customType": "regex",
      "fileMatch": [
        "(^|\\/)tasks\\/install_kubernetes_gateway_api\\.yaml$",
        "(^|\\/)molecule\\/inject_traffic_denying_istio_gateway_authorization_policy\\/create\\.ya?ml$"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Matches opentelemetry-demo release tag embedded in raw GitHub URLs inside molecule create.yml files",
      "customType": "regex",
      "fileMatch": [
        "(^|\\/)molecule\\/inject_opentelemetry_demo_feature_flag\\/create\\.ya?ml$"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/opentelemetry-demo-(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersion": "^opentelemetry-demo-(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "gomod": {
    "postUpdateOptions": [
      "gomodTidy"
    ]
  },
  "ocb": {
    "managerFilePatterns": [
      "/(^|/)builder(-config)?.ya?ml$/"
    ]
  }
}
