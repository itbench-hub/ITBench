{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
        "authors": {
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "description": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "platforms": {
            "items": {
                "enum": [
                    "Kubernetes"
                ],
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        },
        "repository": {
            "type": "string"
        },
        "resources": {
            "items": {
                "type": "string"
            },
            "type": "array",
            "uniqueItems": true
        }
    },
    "required": [
        "authors",
        "description",
        "name",
        "platforms",
        "repository"
    ],
    "type": "object"
}
