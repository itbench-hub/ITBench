{
    "$defs": {
        "FaultAlerts": {
            "description": "Alerts associated with a fault.",
            "enum": [
                "HighRequestErrorRate",
                "HighRequestLatency",
                "KubeContainerWaiting",
                "KubeHpaMaxedOut",
                "KubePodCrashLooping",
                "KubePodNotReady",
                "NoRequestsReceived"
            ],
            "title": "FaultAlerts",
            "type": "string"
        },
        "FaultConvertedStatus": {
            "additionalProperties": false,
            "description": "Conversion metadata for a fault that has been converted into a waiter.",
            "properties": {
                "id": {
                    "description": "Unique slug identifier for the waiter.",
                    "title": "Id",
                    "type": "string"
                },
                "version": {
                    "description": "ITBench version in which the fault was converted.",
                    "title": "Version",
                    "type": "string"
                }
            },
            "required": [
                "id",
                "version"
            ],
            "title": "FaultConvertedStatus",
            "type": "object"
        },
        "FaultRetiredStatus": {
            "additionalProperties": false,
            "description": "Retirement metadata for a fault that has been removed from the active catalog.",
            "properties": {
                "reason": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Reason the fault was retired.",
                    "title": "Reason"
                },
                "version": {
                    "description": "ITBench version in which the fault was retired.",
                    "title": "Version",
                    "type": "string"
                }
            },
            "required": [
                "version"
            ],
            "title": "FaultRetiredStatus",
            "type": "object"
        },
        "FaultSolution": {
            "additionalProperties": false,
            "description": "A single recommended solution comprising ordered remediation steps.",
            "properties": {
                "steps": {
                    "description": "Ordered list of steps to resolve the fault.",
                    "items": {
                        "$ref": "#/$defs/FaultSolutionStep"
                    },
                    "title": "Steps",
                    "type": "array"
                }
            },
            "required": [
                "steps"
            ],
            "title": "FaultSolution",
            "type": "object"
        },
        "FaultSolutionStep": {
            "additionalProperties": false,
            "description": "Individual step in a solution procedure.",
            "properties": {
                "command": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "CLI command to execute for this step.",
                    "title": "Command"
                },
                "text": {
                    "description": "Human-readable description of the troubleshooting step.",
                    "title": "Text",
                    "type": "string"
                }
            },
            "required": [
                "text"
            ],
            "title": "FaultSolutionStep",
            "type": "object"
        },
        "FaultSolutionTemplates": {
            "additionalProperties": false,
            "description": "Solution templates for addressing the fault.",
            "properties": {
                "templates": {
                    "description": "One or more recommended solutions for resolving the fault.",
                    "items": {
                        "$ref": "#/$defs/FaultSolution"
                    },
                    "title": "Templates",
                    "type": "array"
                }
            },
            "required": [
                "templates"
            ],
            "title": "FaultSolutionTemplates",
            "type": "object"
        },
        "FaultStatus": {
            "additionalProperties": false,
            "description": "Lifecycle status for a fault.",
            "properties": {
                "converted": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FaultConvertedStatus"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Conversion metadata, present only if the fault has been converted to a waiter."
                },
                "retired": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FaultRetiredStatus"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Retirement metadata, present only if the fault has been retired."
                }
            },
            "title": "FaultStatus",
            "type": "object"
        },
        "FaultTags": {
            "description": "Categories/tags for faults.",
            "enum": [
                "Authentication",
                "Code",
                "Deployment",
                "Networking",
                "Performance"
            ],
            "title": "FaultTags",
            "type": "string"
        },
        "FaultTargetReference": {
            "additionalProperties": false,
            "description": "A type reference declaring what kind of Kubernetes object a fault targets.\n\nUses the model class name rather than a full object instance \u2014 the concrete\nobject is supplied in the scenario injection's ``targets`` list.",
            "properties": {
                "kubernetes": {
                    "$ref": "#/$defs/KubernetesObjectKind",
                    "description": "Name of the Kubernetes object model this fault targets (e.g. KubernetesWorkload, KubernetesService)."
                }
            },
            "required": [
                "kubernetes"
            ],
            "title": "FaultTargetReference",
            "type": "object"
        },
        "KubernetesGateway": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes Gateway (gateway.networking.k8s.io).",
            "properties": {
                "apiVersion": {
                    "const": "gateway.networking.k8s.io/v1",
                    "default": "gateway.networking.k8s.io/v1",
                    "description": "API version of the Kubernetes Gateway resource. Always gateway.networking.k8s.io/v1.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "const": "Gateway",
                    "default": "Gateway",
                    "description": "Kind of the Kubernetes resource. Always Gateway.",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "description": "Namespace of the Gateway.",
                    "title": "Namespace",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "namespace"
            ],
            "title": "KubernetesGateway",
            "type": "object"
        },
        "KubernetesHorizontalPodAutoscaler": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes Horizontal Pod Autoscaler.",
            "properties": {
                "apiVersion": {
                    "const": "autoscaling/v2",
                    "default": "autoscaling/v2",
                    "description": "API version of the Kubernetes Horizontal Pod Autoscaler resource. Always autoscaling/v2.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "const": "HorizontalPodAutoscaler",
                    "default": "HorizontalPodAutoscaler",
                    "description": "Kind of the Kubernetes resource. Always HorizontalPodAutoscaler.",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "description": "Namespace of the Kubernetes Horizontal Pod Autoscaler.",
                    "title": "Namespace",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "namespace"
            ],
            "title": "KubernetesHorizontalPodAutoscaler",
            "type": "object"
        },
        "KubernetesNamespace": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes Namespace.",
            "properties": {
                "apiVersion": {
                    "const": "v1",
                    "default": "v1",
                    "description": "API version of the Kubernetes Namespace resource. Always v1.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "const": "Namespace",
                    "default": "Namespace",
                    "description": "Kind of the Kubernetes resource. Always Namespace.",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "default": null,
                    "description": "Namespaces are cluster-scoped; this field is always None.",
                    "title": "Namespace",
                    "type": "null"
                }
            },
            "required": [
                "name"
            ],
            "title": "KubernetesNamespace",
            "type": "object"
        },
        "KubernetesObjectKind": {
            "description": "Supported Kubernetes object model class names for target references.",
            "enum": [
                "KubernetesGateway",
                "KubernetesHorizontalPodAutoscaler",
                "KubernetesNamespace",
                "KubernetesSecret",
                "KubernetesService",
                "KubernetesWorkload"
            ],
            "title": "KubernetesObjectKind",
            "type": "string"
        },
        "KubernetesSecret": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes Secret.",
            "properties": {
                "apiVersion": {
                    "const": "v1",
                    "default": "v1",
                    "description": "API version of the Kubernetes Secret resource. Always v1.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "const": "Secret",
                    "default": "Secret",
                    "description": "Kind of the Kubernetes resource. Always Secret.",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "description": "Namespace of the Secret.",
                    "title": "Namespace",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "namespace"
            ],
            "title": "KubernetesSecret",
            "type": "object"
        },
        "KubernetesService": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes Service.",
            "properties": {
                "apiVersion": {
                    "const": "v1",
                    "default": "v1",
                    "description": "API version of the Kubernetes Service resource. Always v1.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "const": "Service",
                    "default": "Service",
                    "description": "Kind of the Kubernetes resource. Always Service.",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "description": "Namespace of the Service.",
                    "title": "Namespace",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "namespace"
            ],
            "title": "KubernetesService",
            "type": "object"
        },
        "KubernetesWorkload": {
            "additionalProperties": false,
            "description": "Reference to a Kubernetes workload (DaemonSet, Deployment, or StatefulSet).",
            "properties": {
                "apiVersion": {
                    "const": "apps/v1",
                    "default": "apps/v1",
                    "description": "API version of the Kubernetes workload resource. Always apps/v1.",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "default": "Deployment",
                    "description": "Kind of the Kubernetes workload. One of DaemonSet, Deployment, or StatefulSet.",
                    "enum": [
                        "DaemonSet",
                        "Deployment",
                        "StatefulSet"
                    ],
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "description": "Namespace of the workload.",
                    "title": "Namespace",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "namespace"
            ],
            "title": "KubernetesWorkload",
            "type": "object"
        },
        "Platform": {
            "description": "Supported platforms for ITBench applications, faults, and waiters.",
            "enum": [
                "Kubernetes",
                "Localhost",
                "OpenShift"
            ],
            "title": "Platform",
            "type": "string"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "This fault injects a Chaos Mesh experiment into the environment. The experiment is [scheduled](https://chaos-mesh.org/docs/define-scheduling-rules/) to repeated fire so that the behavior persists.",
    "properties": {
        "alerts": {
            "description": "Alerts triggered by this fault.",
            "items": {
                "$ref": "#/$defs/FaultAlerts"
            },
            "title": "Alerts",
            "type": "array",
            "uniqueItems": true
        },
        "description": {
            "description": "Description of what the fault does.",
            "title": "Description",
            "type": "string"
        },
        "expectation": {
            "description": "Expected behavior or symptoms observed when the fault is injected.",
            "title": "Expectation",
            "type": "string"
        },
        "name": {
            "description": "Name of the fault.",
            "title": "Name",
            "type": "string"
        },
        "platform": {
            "$ref": "#/$defs/Platform",
            "description": "Target platform."
        },
        "resources": {
            "description": "Reference documentation or links.",
            "items": {
                "type": "string"
            },
            "title": "Resources",
            "type": "array",
            "uniqueItems": true
        },
        "solution_templates": {
            "$ref": "#/$defs/FaultSolutionTemplates",
            "description": "Recommended troubleshooting solutions."
        },
        "status": {
            "anyOf": [
                {
                    "$ref": "#/$defs/FaultStatus"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Lifecycle status of the fault, including retirement metadata if applicable."
        },
        "tags": {
            "description": "Tags categorizing the fault.",
            "items": {
                "$ref": "#/$defs/FaultTags"
            },
            "title": "Tags",
            "type": "array",
            "uniqueItems": true
        },
        "targets": {
            "description": "Kubernetes object types this fault targets, by model class name. Scenario injections must supply a matching concrete object in their own targets list.",
            "items": {
                "$ref": "#/$defs/FaultTargetReference"
            },
            "title": "Targets",
            "type": "array",
            "uniqueItems": true
        }
    },
    "required": [
        "description",
        "expectation",
        "name",
        "platform",
        "solution_templates"
    ],
    "title": "Scheduled Chaos Mesh Experiment",
    "type": "object"
}
