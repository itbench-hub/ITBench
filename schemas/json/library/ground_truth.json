{
    "$defs": {
        "FaultAlerts": {
            "description": "Alerts associated with a fault.",
            "enum": [
                "HighRequestErrorRate",
                "HighRequestLatency",
                "KubeContainerWaiting",
                "KubeHpaMaxedOut",
                "KubePodCrashLooping",
                "KubePodNotReady",
                "NoRequestsReceived"
            ],
            "title": "FaultAlerts",
            "type": "string"
        },
        "FaultSolution": {
            "additionalProperties": false,
            "description": "A single recommended solution comprising ordered remediation steps.",
            "properties": {
                "steps": {
                    "description": "Ordered list of steps to resolve the fault.",
                    "items": {
                        "$ref": "#/$defs/FaultSolutionStep"
                    },
                    "title": "Steps",
                    "type": "array"
                }
            },
            "required": [
                "steps"
            ],
            "title": "FaultSolution",
            "type": "object"
        },
        "FaultSolutionStep": {
            "additionalProperties": false,
            "description": "Individual step in a solution procedure.",
            "properties": {
                "command": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "CLI command to execute for this step.",
                    "title": "Command"
                },
                "text": {
                    "description": "Human-readable description of the troubleshooting step.",
                    "title": "Text",
                    "type": "string"
                }
            },
            "required": [
                "text"
            ],
            "title": "FaultSolutionStep",
            "type": "object"
        },
        "GroundTruthAlert": {
            "additionalProperties": false,
            "description": "A single alert entry in a ground truth definition.",
            "properties": {
                "labels": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Key/value label pairs associated with the alert.",
                    "title": "Labels",
                    "type": "object"
                },
                "name": {
                    "$ref": "#/$defs/FaultAlerts",
                    "description": "Alert identifier."
                }
            },
            "required": [
                "name"
            ],
            "title": "GroundTruthAlert",
            "type": "object"
        },
        "GroundTruthEntities": {
            "additionalProperties": false,
            "description": "Entities of a scenario, grouped by their relationship to the fault.",
            "properties": {
                "faulted": {
                    "$ref": "#/$defs/GroundTruthEntityGroup",
                    "description": "Entities the fault acts on directly, including objects it creates."
                },
                "impacted": {
                    "$ref": "#/$defs/GroundTruthEntityGroup",
                    "description": "Entities affected by cascade from the faulted ones."
                },
                "unchanged": {
                    "$ref": "#/$defs/GroundTruthUnchangedEntityGroup",
                    "description": "Entities that must stay unchanged."
                }
            },
            "required": [
                "faulted"
            ],
            "title": "GroundTruthEntities",
            "type": "object"
        },
        "GroundTruthEntityGroup": {
            "additionalProperties": false,
            "description": "Entities of one relationship to the fault, grouped by entity type.",
            "properties": {
                "kubernetes": {
                    "description": "Kubernetes objects in this group.",
                    "items": {
                        "$ref": "#/$defs/KubernetesObject"
                    },
                    "title": "Kubernetes",
                    "type": "array",
                    "uniqueItems": true
                }
            },
            "title": "GroundTruthEntityGroup",
            "type": "object"
        },
        "GroundTruthField": {
            "additionalProperties": false,
            "description": "A single field of an object that must keep an expected value.",
            "properties": {
                "path": {
                    "description": "JSON key path of the field, e.g. spec.template.spec.containers[0].name.",
                    "title": "Path",
                    "type": "string"
                },
                "value": {
                    "$ref": "#/$defs/JsonValue",
                    "description": "Value the field is expected to hold, e.g. server."
                }
            },
            "required": [
                "path",
                "value"
            ],
            "title": "GroundTruthField",
            "type": "object"
        },
        "GroundTruthUnchangedEntityGroup": {
            "additionalProperties": false,
            "description": "Entities that must stay as they are, grouped by entity type.",
            "properties": {
                "kubernetes": {
                    "description": "Kubernetes objects the fault does not touch and the agent must not change.",
                    "items": {
                        "$ref": "#/$defs/GroundTruthUnchangedKubernetesObject"
                    },
                    "title": "Kubernetes",
                    "type": "array",
                    "uniqueItems": true
                }
            },
            "title": "GroundTruthUnchangedEntityGroup",
            "type": "object"
        },
        "GroundTruthUnchangedKubernetesObject": {
            "additionalProperties": false,
            "description": "A Kubernetes object that the fault does not touch and the agent must not change.",
            "properties": {
                "apiVersion": {
                    "default": "v1",
                    "description": "API version of the Kubernetes resource (e.g. v1, apps/v1).",
                    "title": "Apiversion",
                    "type": "string"
                },
                "fields": {
                    "description": "Fields that must keep the given value. When empty, the whole object must be unchanged.",
                    "items": {
                        "$ref": "#/$defs/GroundTruthField"
                    },
                    "title": "Fields",
                    "type": "array"
                },
                "kind": {
                    "description": "Kind of the Kubernetes resource (e.g. Deployment, Service, Node).",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Namespace of the resource (if namespaced).",
                    "title": "Namespace"
                }
            },
            "required": [
                "kind",
                "name"
            ],
            "title": "GroundTruthUnchangedKubernetesObject",
            "type": "object"
        },
        "JsonValue": {},
        "KubernetesObject": {
            "additionalProperties": false,
            "description": "Base model for a Kubernetes object reference.",
            "properties": {
                "apiVersion": {
                    "default": "v1",
                    "description": "API version of the Kubernetes resource (e.g. v1, apps/v1).",
                    "title": "Apiversion",
                    "type": "string"
                },
                "kind": {
                    "description": "Kind of the Kubernetes resource (e.g. Deployment, Service, Node).",
                    "title": "Kind",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the Kubernetes resource.",
                    "title": "Name",
                    "type": "string"
                },
                "namespace": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Namespace of the resource (if namespaced).",
                    "title": "Namespace"
                }
            },
            "required": [
                "kind",
                "name"
            ],
            "title": "KubernetesObject",
            "type": "object"
        }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Ground truth definition for a benchmark scenario.",
    "properties": {
        "alerts": {
            "description": "Alerts expected to fire when the fault is active.",
            "items": {
                "$ref": "#/$defs/GroundTruthAlert"
            },
            "title": "Alerts",
            "type": "array",
            "uniqueItems": true
        },
        "entities": {
            "$ref": "#/$defs/GroundTruthEntities",
            "description": "Entities involved in the fault, grouped by their relationship to it."
        },
        "solutions": {
            "description": "One entry per fault injection, each containing one or more alternative remediation paths (solution templates) for that injection.",
            "items": {
                "items": {
                    "$ref": "#/$defs/FaultSolution"
                },
                "type": "array"
            },
            "title": "Solutions",
            "type": "array"
        }
    },
    "required": [
        "entities",
        "solutions"
    ],
    "title": "GroundTruth",
    "type": "object"
}
